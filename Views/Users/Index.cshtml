@model IEnumerable<FlexiFit_AdminPanel.Models.User>

<div class="content-area">
    <div class="page-header" style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 2rem;">
        <h2 style="font-weight: 700;">User Management</h2>
        <button class="btn" data-bs-toggle="modal" data-bs-target="#addUserModal">
            <i class="fas fa-plus"></i> Add New User
        </button>
    </div>

    <div class="card" style="padding: 0; overflow: hidden;">
        <table>
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Username</th>
                    <th>Email Address</th>
                    <th>Role</th>
                    <th style="text-align: center;">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var user in Model)
                {
                    <tr>
                        <td>#@user.user_id</td>
                        <td style="font-weight: 600; color: #6366f1;">@user.username</td>
                        <td>@user.email</td>
                        <td><span class="badge-role">@user.role</span></td>
                        <td>
                            <div class="action-group" style="display: flex; gap: 8px; justify-content: center;">
                                <a asp-action="Edit" asp-route-id="@user.user_id" class="btn" style="background: #fbbf24; color: #78350f; padding: 6px 12px; font-size: 13px;">
                                    <i class="fas fa-edit"></i> Edit
                                </a>
                                <form asp-action="Delete" asp-route-id="@user.user_id" method="post" onsubmit="return confirmDelete('@user.username')" style="margin:0;">
                                    <button type="submit" class="btn btn-danger" style="padding: 6px 12px; font-size: 13px;">
                                        <i class="fas fa-trash"></i> Delete
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<div class="modal fade" id="addUserModal" tabindex="-1" aria-labelledby="addUserModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content" style="background: #1e293b; border: 1px solid #334155; border-radius: 12px; color: white;">

            <div class="modal-header" style="border-bottom: 1px solid #334155; padding: 20px;">
                <h5 class="modal-title" id="addUserModalLabel">Add New User</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <div style="padding: 24px 24px 0 24px;">
                <button type="button" id="btnGoogleAdd" onclick="useGoogleProvider()" class="btn" style="width: 100%; background: #ffffff; color: #334155; justify-content: center; font-weight: 600; display: flex; align-items: center; gap: 10px;">
                    <img src="https://upload.wikimedia.org/wikipedia/commons/c/c1/Google_%22G%22_logo.svg" width="18" alt="Google logo" />
                    Quick Add via Google Account
                </button>

                <div style="text-align: center; margin-top: 20px; position: relative;">
                    <span style="background: #1e293b; padding: 0 15px; color: #94a3b8; font-size: 11px; font-weight: 700; position: relative; z-index: 1; letter-spacing: 1px;">OR MANUAL INPUT</span>
                    <hr style="position: absolute; top: 50%; width: 100%; border-color: #334155; margin: 0; opacity: 1;" />
                </div>
            </div>

            <form asp-action="Create" method="post" id="addUserForm">
                <div class="modal-body" style="padding: 24px;">
                    <div style="margin-bottom: 18px;">
                        <label style="display:block; margin-bottom: 8px; color: #94a3b8; font-size: 13px;">Full Name</label>
                        <input type="text" name="name" id="modalName" class="search" style="width: 100%;" placeholder="e.g. Juan Dela Cruz" required>
                    </div>

                    <div style="margin-bottom: 18px;">
                        <label style="display:block; margin-bottom: 8px; color: #94a3b8; font-size: 13px;">Username</label>
                        <input type="text" name="username" id="modalUsername" class="search" style="width: 100%;" placeholder="e.g. juan_dc" required>
                    </div>

                    <div style="margin-bottom: 18px;">
                        <label style="display:block; margin-bottom: 8px; color: #94a3b8; font-size: 13px;">Email Address</label>
                        <input type="email" name="email" id="modalEmail" class="search" style="width: 100%;" placeholder="juan@sscr.edu" required>
                    </div>

                    <div style="margin-bottom: 5px;">
                        <label style="display:block; margin-bottom: 8px; color: #94a3b8; font-size: 13px;">Assign Role</label>
                        <select name="role" class="search" style="width: 100%; background: #0f172a;">
                            <option value="User">User (Standard Access)</option>
                            <option value="Admin">Admin (Full Control)</option>
                        </select>
                    </div>

                    <input type="hidden" name="firebase_uid" id="modalUid" value="">
                    <input type="hidden" name="auth_provider" id="modalProvider" value="EMAIL">
                </div>

                <div class="modal-footer" style="border-top: 1px solid #334155; padding: 20px; gap: 10px;">
                    <button type="button" class="btn" style="background: #475569; border: none;" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn" style="background: #6366f1; border: none;">Confirm & Create</button>
                </div>
            </form>
        </div>
    </div>
</div>