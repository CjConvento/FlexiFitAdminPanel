@model FlexiFit_AdminPanel.Models.WorkoutItem

<div class="content-area">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 25px;">
        <div>
            <h2 style="margin: 0; font-weight: 700; color: #f8fafc;">✏️ Edit Workout</h2>
            <p style="color: #94a3b8; font-size: 14px; margin: 0;">Update the details for #@Model.workout_id - @Model.workout_name</p>
        </div>
        <a asp-action="Index" class="btn" style="background: #475569;">Back to List</a>
    </div>

    <div class="card">
        <form asp-action="Edit" method="post" enctype="multipart/form-data">
            @* IMPORTANT: Kailangan ito para malaman ng SQL kung anong ID ang i-uupdate *@
            <input type="hidden" asp-for="workout_id" />

            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px;">
                <div class="form-group">
                    <label style="color: #94a3b8; font-size: 13px;">Workout Name</label>
                    <input asp-for="workout_name" class="search" style="width: 100%; margin-top: 8px;" required />
                </div>

                <div class="form-group">
                    <label style="color: #94a3b8; font-size: 13px; font-weight: 600;">Category</label>
                    <select asp-for="category" class="search" style="width: 100%; margin-top: 8px; background: #0f172a;">
                        <option value="MUSCLE_GAIN">Muscle Gain</option>
                        <option value="CARDIO">Cardio / Warmup</option>
                        <option value="REHAB">Rehab</option>
                        <option value="WARMUP">Warmup</option>
                    </select>
                </div>

                <div class="form-group">
                    <label style="color: #94a3b8; font-size: 13px;">Muscle Group</label>
                    <input asp-for="muscle_group" class="search" style="width: 100%; margin-top: 8px;" />
                </div>

                <div class="form-group">
                    <label style="color: #94a3b8; font-size: 13px;">Difficulty Level</label>
                    <select asp-for="difficulty_level" class="search" style="width: 100%; margin-top: 8px; background: #0f172a;">
                        <option value="Beginner">Beginner</option>
                        <option value="Intermediate">Intermediate</option>
                        <option value="Advanced">Advanced</option>
                    </select>
                </div>

                <div class="form-group">
                    <label style="color: #94a3b8; font-size: 13px; font-weight: 600;">Equipment</label>
                    <select asp-for="equipment" class="search" style="width: 100%; margin-top: 8px; background: #0f172a;">
                        <option value="">Select Equipment</option>
                        <option value="HOME EQUIPMENT">HOME EQUIPMENT</option>
                        <option value="GYM EQUIPMENT">GYM EQUIPMENT</option>
                        <option value="OUTDOOR EQUIPMENT">OUTDOOR EQUIPMENT</option>
                    </select>
                </div>

                <div class="form-group">
                    <label style="color: #94a3b8; font-size: 13px; font-weight: 600;">Environment</label>
                    <select asp-for="environment" class="search" style="width: 100%; margin-top: 8px; background: #0f172a;">
                        <option value="">Select Environment</option>
                        <option value="HOME">HOME</option>
                        <option value="GYM">GYM</option>
                        <option value="OUTDOOR">OUTDOOR</option>
                    </select>
                </div>

                <div class="form-group">
                    <label style="color: #94a3b8; font-size: 13px;">Duration (mins)</label>
                    <input asp-for="duration" type="number" class="search" style="width: 100%; margin-top: 8px;" />
                </div>

                <div class="form-group">
                    <label style="color: #94a3b8; font-size: 13px;">Calories Burned</label>
                    <input asp-for="calories_burned" type="number" class="search" style="width: 100%; margin-top: 8px;" />
                </div>

                <div class="form-group">
                    <label style="color: #94a3b8; font-size: 13px;">Status</label>
                    <select asp-for="is_active" class="search" style="width: 100%; margin-top: 8px; background: #0f172a;">
                        <option value="true">Active</option>
                        <option value="false">Inactive</option>
                    </select>
                </div>

                @* ✅ NEW: Image Upload Section *@
                <div class="form-group" style="grid-column: span 2;">
                    <label style="color: #94a3b8; font-size: 13px; font-weight: 600;">Workout Image</label>
                    
                    @* Display current image *@
                    @if (!string.IsNullOrEmpty(Model.img_filename))
                    {
                        <div style="margin-top: 8px; margin-bottom: 12px;">
                            <img src="@ImageUrlHelper.GetFullImageUrl(Model.img_filename, "workouts")" 
                                 style="max-width: 200px; max-height: 200px; border-radius: 8px; border: 1px solid #334155;" id="imagePreview" />  @* ✅ ADDED ID *@
                            <p style="color: #94a3b8; font-size: 12px; margin-top: 4px;">Current image: @Model.img_filename</p>
                        </div>
                    }
                    else
                    {
                        <div style="margin-top: 8px; margin-bottom: 12px;">
                            <img src="@ImageUrlHelper.GetDefaultImage("workouts")" 
                                 style="max-width: 200px; max-height: 200px; border-radius: 8px; border: 1px solid #334155;" id="imagePreview" />  @* ✅ ADDED ID *@
                            <p style="color: #94a3b8; font-size: 12px; margin-top: 4px;">No image uploaded</p>
                        </div>
                    }
                    
                    <input type="file" name="imageFile" class="form-control" style="margin-top: 8px; background: #0f172a; color: #f8fafc; border: 1px solid #334155; padding: 8px; border-radius: 8px;" onchange="previewImage(this)" />  @* ✅ ADDED onchange *@
                    <small style="color: #64748b;">Upload a new image to replace the current one (optional)</small>
                </div>
            </div>

            <div style="margin-top: 30px; border-top: 1px solid #334155; padding-top: 25px; display: flex; gap: 10px;">
                <button type="submit" class="btn">Update Workout</button>
                <a asp-action="Index" class="btn" style="background: transparent; border: 1px solid #334155;">Cancel</a>
            </div>
        </form>
    </div>
</div>

@* ✅ ADD THIS SECTION AT THE BOTTOM *@
@section Scripts {
    <script src="~/js/image-preview.js"></script>
}