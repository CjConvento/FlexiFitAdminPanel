@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Authentication
@using Microsoft.AspNetCore.Authentication.Cookies
@using System.Security.Claims
@using FlexiFit_AdminPanel.Models
@using FlexiFit_AdminPanel.Helpers
@using FirebaseAdmin.Auth
@using Microsoft.Data.SqlClient
@using Dapper
@using Microsoft.JSInterop
@using System.Net.Http
@using Microsoft.Extensions.Logging

@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime
@inject IConfiguration Configuration
@inject IHttpContextAccessor HttpContextAccessor
@inject HttpClient Http
@inject ILogger<Login> Logger

<h2>Flexifit Admin</h2>
<p>Enter your credentials to access the panel</p>

<!-- Error Message -->
@if (!string.IsNullOrEmpty(ErrorMessage))
{
    <div class="error-msg">
        <i class="fas fa-exclamation-circle me-1"></i>
        @ErrorMessage
    </div>
}

<!-- 🔥 Google Login Button -->
<button @onclick="LoginWithGoogle" class="btn-login btn-google">
    <img src="https://upload.wikimedia.org/wikipedia/commons/c/c1/Google_%22G%22_logo.svg" 
         width="20" alt="Google" />
    Sign in with Google (Admin)
</button>

<div class="divider">OR</div>

<!-- Manual Login Form -->
<form @onsubmit="LoginWithPassword" class="manual-form">
    <div class="mb-3">
        <label class="form-label">Username</label>
        <input @bind="Username" class="form-control" placeholder="admin" />
    </div>
    <div class="mb-3">
        <label class="form-label">Password</label>
        <input @bind="Password" type="password" class="form-control" placeholder="••••••••" />
    </div>

    <button type="submit" class="btn-login btn-primary">
        Sign In <i class="fas fa-arrow-right ms-2"></i>
    </button>
</form>

@code {
    private string Username { get; set; } = "";
    private string Password { get; set; } = "";
    private string ErrorMessage { get; set; } = "";
    private bool IsLoading { get; set; } = false;

    private string ConnectionString => Configuration.GetConnectionString("FlexifitDb")
        ?? throw new InvalidOperationException("Connection string 'FlexifitDb' not found.");

    // 🔥 Google Login
    private async Task LoginWithGoogle()
    {
        try
        {
            IsLoading = true;
            ErrorMessage = "";

            Logger.LogInformation("🔍 Starting Google login...");

            var token = await JSRuntime.InvokeAsync<string>("firebaseLogin");

            Logger.LogInformation("🔍 Token received: {Status}", string.IsNullOrEmpty(token) ? "NULL" : "OK");

            if (string.IsNullOrEmpty(token))
            {
                ErrorMessage = "Failed to get Google token.";
                return;
            }

            await ProcessFirebaseToken(token);
        }
        catch (TaskCanceledException ex)
        {
            Logger.LogWarning(ex, "❌ Task canceled during Google login");
            ErrorMessage = "Login was canceled. Please try again.";
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "❌ Google login error");
            ErrorMessage = $"Error: {ex.Message}";
        }
        finally
        {
            IsLoading = false;
        }
    }

    // 🔐 Manual Login
    private async Task LoginWithPassword()
    {
        try
        {
            IsLoading = true;
            ErrorMessage = "";

            Logger.LogInformation("🔍 Login attempt for username: {Username}", Username);

            if (string.IsNullOrEmpty(Username) || string.IsNullOrEmpty(Password))
            {
                Logger.LogWarning("❌ Username or password is empty");
                ErrorMessage = "Please enter username and password.";
                return;
            }

            using var connection = new SqlConnection(ConnectionString);
            Logger.LogInformation("📡 Opening database connection...");

            var sql = @"
                SELECT user_id, username, email, role, firebase_uid, name, password_hash 
                FROM dbo.usr_users 
                WHERE username = @Username AND status = 'active'";

            Logger.LogInformation("📝 Executing query for username: {Username}", Username);

            var user = await connection.QueryFirstOrDefaultAsync<User>(
                sql, new { Username = Username });

            if (user == null)
            {
                Logger.LogWarning("❌ User not found: {Username}", Username);
                ErrorMessage = "Invalid credentials.";
                return;
            }

            Logger.LogInformation("✅ User found: {Username}, Role: {Role}, ID: {UserId}", user.username, user.role, user.user_id);

            if (user.role?.ToUpper() != "ADMIN")
            {
                Logger.LogWarning("❌ User {Username} is not ADMIN (Role: {Role})", user.username, user.role);
                ErrorMessage = "Admin access required.";
                return;
            }

            if (!string.IsNullOrEmpty(user.password_hash))
            {
                Logger.LogInformation("🔐 Verifying password hash for user: {Username}", user.username);
                if (!PasswordHelper.VerifyPassword(Password, user.password_hash))
                {
                    Logger.LogWarning("❌ Password verification failed for user: {Username}", user.username);
                    ErrorMessage = "Invalid credentials.";
                    return;
                }
                Logger.LogInformation("✅ Password verified for user: {Username}", user.username);
            }
            else
            {
                Logger.LogInformation("🔐 Creating password hash for user: {Username}", user.username);
                var hashedPassword = PasswordHelper.HashPassword(Password);
                await UpdatePasswordHash(user.user_id, hashedPassword);
                Logger.LogInformation("✅ Password hash created for user: {Username}", user.username);
            }

            // Validate user_id before redirect
            if (user.user_id <= 0)
            {
                Logger.LogWarning("❌ Invalid user ID: {UserId} for user: {Username}", user.user_id, user.username);
                ErrorMessage = "Invalid user ID. Please try again.";
                return;
            }

            await CreateAdminSession(user);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "❌ Login error for username: {Username}", Username);
            ErrorMessage = $"Login error: {ex.Message}";
        }
        finally
        {
            IsLoading = false;
        }
    }

    // 🔥 Process Firebase Token
    private async Task ProcessFirebaseToken(string firebaseToken)
    {
        try
        {
            Logger.LogInformation("🔥 Verifying Firebase token...");
            var decodedToken = await FirebaseAuth.DefaultInstance
                .VerifyIdTokenAsync(firebaseToken);

            var firebaseUid = decodedToken.Uid;
            var email = decodedToken.Claims.GetValueOrDefault("email")?.ToString();

            Logger.LogInformation("🔥 Firebase user: UID={FirebaseUid}, Email={Email}", firebaseUid, email);

            using var connection = new SqlConnection(ConnectionString);
            var sql = @"
                SELECT user_id, username, email, role, firebase_uid, name 
                FROM dbo.usr_users 
                WHERE firebase_uid = @FirebaseUid OR email = @Email";

            var user = await connection.QueryFirstOrDefaultAsync<User>(
                sql, new { FirebaseUid = firebaseUid, Email = email });

            if (user == null)
            {
                Logger.LogWarning("❌ Firebase user not found in database: {FirebaseUid}", firebaseUid);
                ErrorMessage = "User not registered in the system.";
                return;
            }

            Logger.LogInformation("✅ Firebase user found: {Username}, Role: {Role}", user.username, user.role);

            if (user.role?.ToUpper() != "ADMIN")
            {
                Logger.LogWarning("❌ Firebase user {Username} is not ADMIN", user.username);
                ErrorMessage = "Access denied. Admin privileges required.";
                return;
            }

            await CreateAdminSession(user);
        }
        catch (FirebaseAuthException ex)
        {
            Logger.LogError(ex, "❌ Firebase authentication failed");
            ErrorMessage = $"Authentication failed: {ex.Message}";
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "❌ Firebase login error");
            ErrorMessage = $"Error: {ex.Message}";
        }
    }

    private async Task CreateAdminSession(User user)
    {
        try
        {
            if (user == null || user.user_id <= 0)
            {
                Logger.LogWarning("❌ Invalid user data in CreateAdminSession");
                ErrorMessage = "Invalid user data. Please try again.";
                return;
            }

            Logger.LogInformation("✅ Redirecting to CompleteLogin for user: {Username} (ID: {UserId})", user.username, user.user_id);
            Navigation.NavigateTo($"/Account/CompleteLogin?userId={user.user_id}", true);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "❌ CreateAdminSession error for user: {Username}", user?.username);
            ErrorMessage = $"Session error: {ex.Message}";
        }
    }

    // ✅ Update Password Hash
    private async Task UpdatePasswordHash(int userId, string hashedPassword)
    {
        try
        {
            using var connection = new SqlConnection(ConnectionString);
            var sql = "UPDATE dbo.usr_users SET password_hash = @Hash WHERE user_id = @UserId";
            await connection.ExecuteAsync(sql, new { Hash = hashedPassword, UserId = userId });
            Logger.LogInformation("✅ Password hash updated for user ID: {UserId}", userId);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "❌ Failed to update password hash for user ID: {UserId}", userId);
            throw;
        }
    }
}