@model IEnumerable<FlexiFit_AdminPanel.Models.ActivityLogItem>
@{
    ViewData["Title"] = "Activity Logs";
    var currentPage = (int)ViewBag.CurrentPage;
    var totalPages = (int)ViewBag.TotalPages;
    var search = ViewBag.Search as string;
    var fromDate = ViewBag.FromDate as string;
    var toDate = ViewBag.ToDate as string;
}

<div class="content-area">
    <div class="page-header" style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 2rem;">
        <div>
            <h2 style="font-weight: 700;">Activity Logs</h2>
            <p style="color: #94a3b8;">Track user activities across workouts, nutrition, and hydration.</p>
        </div>
    </div>

    <!-- Filter Bar -->
    <div class="card" style="margin-bottom: 2rem;">
        <div class="card-body">
            <form method="get" class="form-grid" style="grid-template-columns: repeat(4, 1fr); gap: 15px;">
                <div>
                    <label>Search</label>
                    <input type="text" name="search" value="@search" class="search-input" placeholder="Username, email, or activity details" />
                </div>
                <div>
                    <label>From Date</label>
                    <input type="date" name="fromDate" value="@fromDate" class="search-input" />
                </div>
                <div>
                    <label>To Date</label>
                    <input type="date" name="toDate" value="@toDate" class="search-input" />
                </div>
                <div style="display: flex; align-items: flex-end;">
                    <button type="submit" class="btn" style="width: 100%;">Apply Filters</button>
                </div>
            </form>
        </div>
    </div>

    <!-- Activity Table -->
    <div class="card" style="overflow-x: auto;">
        <table>
            <thead>
                <tr>
                    <th>User</th>
                    <th>Activity Type</th>
                    <th>Date</th>
                    <th>Details</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="4" style="text-align: center;">No activities found.</td>
                    </tr>
                }
                else
                {
                    foreach (var log in Model)
                    {
                        <tr>
                            <td>
                                <strong>@log.username</strong><br />
                                <small style="color:#94a3b8;">@log.email</small>
                            </td>
                            <td>
                                <span class="badge-role" style="background: @(log.activity_type == "Workout" ? "#10b981" : log.activity_type == "Nutrition" ? "#3b82f6" : "#f59e0b");">
                                    @log.activity_type
                                </span>
                            </td>
                            <td>@log.activity_date?.ToString("MMM dd, yyyy")</td>
                            <td>@log.details</td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    <!-- Pagination -->
    @if (totalPages > 1)
    {
        <div style="display: flex; justify-content: center; gap: 10px; margin-top: 2rem;">
            @if (currentPage > 1)
            {
                <a asp-action="Index" asp-route-page="@(currentPage - 1)" asp-route-search="@search" asp-route-fromDate="@fromDate" asp-route-toDate="@toDate" class="btn btn-secondary">Previous</a>
            }
            <span style="padding: 10px;">Page @currentPage of @totalPages</span>
            @if (currentPage < totalPages)
            {
                <a asp-action="Index" asp-route-page="@(currentPage + 1)" asp-route-search="@search" asp-route-fromDate="@fromDate" asp-route-toDate="@toDate" class="btn btn-secondary">Next</a>
            }
        </div>
    }
</div>

@section Scripts {
    <script>
        // Optional: enhance with date picker or autocomplete
    </script>
}