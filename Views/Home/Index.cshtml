@* 1. I-load muna ang Chart.js Library *@
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<div class="container-fluid p-4">
    @* Data Bridge - Hidden elements para sa JS *@
    <div id="dashboard-data"
         data-users="@ViewBag.TotalUsers"
         data-workouts="@ViewBag.TotalWorkouts"
         data-foods="@ViewBag.TotalFoods"
         style="display:none;"></div>

    @* Header Section *@
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold m-0 text-white">⚡ Overview</h2>
            <p class="text-secondary small">Real-time stats for Flexifit Admin</p>
        </div>
        <button class="btn btn-outline-primary btn-sm rounded-pill px-3 shadow-glow">
            <i class="fas fa-download me-2"></i>Export Report
        </button>
    </div>

    @* Stats Cards *@
    <div class="row g-4 mb-4">
        <div class="col-md-4">
            <div class="glass-card d-flex align-items-center">
                <div class="icon-box bg-primary-soft me-3"><i class="fas fa-users text-primary"></i></div>
                <div>
                    <div class="text-secondary small fw-medium">Total Users</div>
                    <div class="h3 fw-bold m-0 text-white">@ViewBag.TotalUsers</div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="glass-card d-flex align-items-center">
                <div class="icon-box bg-success-soft me-3"><i class="fas fa-dumbbell text-success"></i></div>
                <div>
                    <div class="text-secondary small fw-medium">Workouts</div>
                    <div class="h3 fw-bold m-0 text-white">@ViewBag.TotalWorkouts</div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="glass-card d-flex align-items-center">
                <div class="icon-box bg-warning-soft me-3"><i class="fas fa-utensils text-warning"></i></div>
                <div>
                    <div class="text-secondary small fw-medium">Food Items</div>
                    <div class="h3 fw-bold m-0 text-white">@ViewBag.TotalFoods</div>
                </div>
            </div>
        </div>
    </div>

    @* Charts Section *@
    <div class="row g-4">
        <div class="col-lg-8">
            <div class="glass-card h-100">
                <h6 class="fw-bold mb-4 text-white">Growth Analytics</h6>
                <div style="height: 300px;">
                    <canvas id="growthChart"></canvas>
                </div>
            </div>
        </div>
        <div class="col-lg-4">
            <div class="glass-card h-100 text-center">
                <h6 class="fw-bold mb-4 text-start text-white">Data Split</h6>
                <div style="height: 250px;">
                    <canvas id="distPieChart"></canvas>
                </div>
                <div class="mt-4 small text-secondary">Distribution of records in SQL Database</div>
            </div>
        </div>
    </div>
</div>

@* --- CRITICAL: SCRIPT PLACEMENT --- *@
<script>
    // Dapat maunang ma-declare ito bago ang admin-logic.js
    const workoutCount = @(ViewBag.TotalWorkouts ?? 0);
    const foodCount = @(ViewBag.TotalFoods ?? 0);
    const userCount = @(ViewBag.TotalUsers ?? 0);
</script>

@* Huli dapat ang iyong custom logic file *@
<script src="~/js/admin-logic.js"></script>