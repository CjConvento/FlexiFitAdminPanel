@model FlexiFit_AdminPanel.Models.FoodItem

<div class="main-content">
    <div class="top-header">
        <h2 style="margin: 0;">🍎 Add New Food</h2>
        <a asp-action="Index" class="btn" style="background: #64748b;">Back to List</a>
    </div>

    <div class="content-area">
        <div class="card">
            <form asp-action="Create" method="post" enctype="multipart/form-data">
                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px;">
                    <div class="form-group">
                        <label style="color: #94a3b8;">Food Name</label>
                        <input asp-for="food_name" class="search" style="width: 100%; margin-top: 8px;" required />
                    </div>
                    
                    <div class="form-group">
                        <label style="color: #94a3b8;">Category</label>
                        <select asp-for="category" class="search" style="width: 100%; margin-top: 8px; background: #0f172a;">
                            <option value="Food">Food</option>
                            <option value="Addon">Addon</option>
                        </select>
                    </div>

                    <div class="form-group">
                        <label style="color: #94a3b8;">Calories (kcal)</label>
                        <input asp-for="calories" type="number" step="0.01" class="search" style="width: 100%; margin-top: 8px;" />
                    </div>
                    <div class="form-group">
                        <label style="color: #94a3b8;">Protein (g)</label>
                        <input asp-for="protein" type="number" step="0.01" class="search" style="width: 100%; margin-top: 8px;" />
                    </div>
                    <div class="form-group">
                        <label style="color: #94a3b8;">Carbs (g)</label>
                        <input asp-for="carbs" type="number" step="0.01" class="search" style="width: 100%; margin-top: 8px;" />
                    </div>
                    <div class="form-group">
                        <label style="color: #94a3b8;">Fats (g)</label>
                        <input asp-for="fats" type="number" step="0.01" class="search" style="width: 100%; margin-top: 8px;" />
                    </div>

                    <div class="form-group">
                        <label style="color: #94a3b8; font-size: 13px; font-weight: 600;">Status</label>
                        <select asp-for="is_active" class="search" style="width: 100%; margin-top: 8px; background: #0f172a;">
                            <option value="true">Active</option>
                            <option value="false">Inactive</option>
                        </select>
                    </div>

                    <div class="form-group" style="grid-column: span 2; border-top: 1px solid #334155; padding-top: 20px; margin-top: 10px;">
                        <label style="color: #94a3b8; font-size: 13px; font-weight: 600;">Food Image</label>
                        
                        <div style="margin-top: 8px; margin-bottom: 12px;">
                            <img src="@ImageUrlHelper.GetDefaultImage("foods")" 
                                style="max-width: 200px; max-height: 200px; border-radius: 8px; border: 1px solid #334155; object-fit: cover;" 
                                id="imagePreview" />
                            <p style="color: #94a3b8; font-size: 12px; margin-top: 4px;">Default image (upload a new one to replace)</p>
                        </div>
                        
                        <input type="file" name="imageFile" class="form-control" 
                            style="margin-top: 8px; background: #0f172a; color: #f8fafc; border: 1px solid #334155; padding: 8px; border-radius: 8px; width: 100%;"
                            accept="image/*" onchange="previewImage(this)" />
                        <small style="color: #64748b;">Upload an image for this food (optional)</small>
                    </div>

                </div>

                <div style="margin-top: 30px; border-top: 1px solid #334155; padding-top: 25px; display: flex; justify-content: flex-end;">
                    <button type="submit" class="btn" style="padding: 12px 30px;">
                        <i class="fas fa-save"></i> Save Food Item
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@* ✅ ADD THIS SECTION AT THE BOTTOM *@
@section Scripts {
    <script src="~/js/image-preview.js"></script>
}