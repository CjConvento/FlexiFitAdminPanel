@model FlexiFit_AdminPanel.Models.User

@{
    ViewData["Title"] = "Edit User";
}

<div class="content-area">
    <div class="page-header">
        <div>
            <h2 style="font-weight: 700;">Edit User</h2>
            <p style="color: #94a3b8; font-size: 14px;">Update the profile information and system permissions for <strong>@Model.username</strong>.</p>
        </div>
    </div>

    <div class="card" style="max-width: 700px;">
        <div style="padding: 24px; border-bottom: 1px solid #334155; background: rgba(99, 102, 241, 0.05);">
            <h5 style="margin: 0; color: #818cf8;"><i class="fas fa-user-edit me-2"></i> Update User Details</h5>
        </div>

        <div class="card-body" style="padding: 30px;">
            <form asp-action="Edit" method="post">
                <input type="hidden" asp-for="user_id" />

                <div style="margin-bottom: 20px;">
                    <label asp-for="username" style="display:block; margin-bottom: 8px; color: #94a3b8; font-size: 14px;">Username</label>
                    <input asp-for="username" class="search-input" style="width: 100%;" placeholder="Enter username" required />
                    <span asp-validation-for="username" style="color: #ef4444; font-size: 12px;"></span>
                </div>

                <div style="margin-bottom: 20px;">
                    <label asp-for="email" style="display:block; margin-bottom: 8px; color: #94a3b8; font-size: 14px;">Email Address</label>
                    <input asp-for="email" class="search-input" style="width: 100%;" type="email" placeholder="email@example.com" required />
                    <span asp-validation-for="email" style="color: #ef4444; font-size: 12px;"></span>
                </div>

                <div style="margin-bottom: 30px;">
                    <label asp-for="role" style="display:block; margin-bottom: 8px; color: #94a3b8; font-size: 14px;">System Role</label>
                    <select asp-for="role" class="search-input" style="width: 100%; cursor: pointer;">
                        <option value="User">User</option>
                        <option value="Admin">Admin</option>
                    </select>
                    <span asp-validation-for="role" style="color: #ef4444; font-size: 12px;"></span>
                </div>

                <div style="display: flex; justify-content: space-between; align-items: center; border-top: 1px solid #334155; padding-top: 25px;">
                    <a asp-action="Index" style="color: #94a3b8; text-decoration: none; font-size: 14px; display: flex; align-items: center; gap: 8px;">
                        <i class="fas fa-arrow-left"></i> Back to List
                    </a>
                    <button type="submit" class="btn-primary">
                        <i class="fas fa-save me-1"></i> Save Changes
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}