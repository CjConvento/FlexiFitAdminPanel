<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"] - Flexifit Admin</title>

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <link rel="stylesheet" href="~/css/admin-style.css">
        @RenderSection("Styles", required: false)
    </head>
    <body>
        <div class="admin-container">
            <div class="sidebar" id="sidebar">
                <div class="logo">
                    <span>FlexiFit Admin</span>
                    <button id="sidebarToggle" class="toggle-btn">☰</button>
                </div>

                <a class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Home" ? "active" : "")"
                       asp-controller="Home" asp-action="Index">
                    <i class="fas fa-chart-line"></i> <span>Dashboard</span>
                </a>

                <a class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Users" ? "active" : "")"
                       asp-controller="Users" asp-action="Index">
                    <i class="fas fa-users"></i> <span>User Management</span>
                </a>

                <a class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Workouts" ? "active" : "")"
                       asp-controller="Workouts" asp-action="Index">
                    <i class="fas fa-dumbbell"></i> <span>Workouts</span>
                </a>

                <a class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Workouts" && ViewContext.RouteData.Values["Action"]?.ToString() == "Tutorials" ? "active" : "")"
                       asp-controller="Workouts" asp-action="Tutorials">
                    <i class="fas fa-video"></i> <span>Workout Tutorials</span>
                </a>

                <a class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Foods" ? "active" : "")"
                       asp-controller="Foods" asp-action="Index">
                    <i class="fas fa-utensils"></i> <span>Foods</span>
                </a>

                <a class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "ActLogs" ? "active" : "")"
                       asp-controller="ActLogs" asp-action="Index">
                    <i class="fas fa-history"></i> <span>Activity Logs</span>
                </a>

                <a class="nav-link text-danger" asp-controller="Account" asp-action="Logout">
                    <i class="fas fa-sign-out-alt"></i> <span>Logout</span>
                </a>
            </div>

            <div class="main-content">
                <div class="top-header">
                    <h2>FlexiFit Admin Panel</h2>
                </div>
                <div class="content-area">
                    @RenderBody()
                </div>
            </div>
        </div>

        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
        <script src="https://www.gstatic.com/firebasejs/9.22.0/firebase-app-compat.js"></script>
        <script src="https://www.gstatic.com/firebasejs/9.22.0/firebase-auth-compat.js"></script>
        <script src="~/js/firebase-config.js"></script>
        <script src="~/js/admin-logic.js"></script>

        @RenderSection("Scripts", required: false)
    </body>
</html>