@{
    ViewData["Title"] = "Secure Developer Tools";
}

<div class="container-fluid p-4">
    @* Header *@
    <div class="mb-4">
        <h2 class="fw-bold m-0 text-white">Secure Developer Token Extractor</h2>
        <p class="text-secondary small">Staging Slot Sandbox Environment</p>
    </div>

    @* Tools Body Card *@
    <div class="card bg-dark border-secondary text-white shadow-sm" style="background: rgba(30, 30, 40, 0.6) !important; backdrop-filter: blur(10px);">
        <div class="card-body p-4">
            <p class="text-secondary small">
                I-click ang <strong>Get & Copy Token</strong> upang makuha ang iyong kasalukuyang JWT string. 
                <span class="text-danger fw-bold">⚠️ Paalala: Manatili sa tab na ito sa loob ng 5 segundo upang awtomatikong mabura ang iyong clipboard para sa seguridad!</span>
            </p>
            
            @* Masked Input Field *@
            <div class="input-group mb-3">
                <input type="password" id="secretTokenHolder" class="form-control text-truncate border-secondary bg-dark text-white" readonly value="@ViewBag.DeveloperJwtToken" placeholder="••••••••••••••••••••••••••••••••" style="font-family: monospace;">
                <button class="btn btn-outline-secondary" type="button" id="togglePasswordBtn" onclick="toggleTokenVisibility()" disabled>
                    👁️ Show
                </button>
            </div>

            <div class="d-flex gap-2">
                <button type="button" class="btn btn-primary fw-bold" onclick="handleTokenScraping()">
                    🎯 Get & Copy Token
                </button>
                <span id="clipboardStatus" class="align-self-center fw-bold ms-2" style="display: none;"></span>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let countdownInterval;
        let clearClipboardTimeout;

        function toggleTokenVisibility() {
            const tokenField = document.getElementById('secretTokenHolder');
            const toggleBtn = document.getElementById('togglePasswordBtn');
            
            if (tokenField.type === "password") {
                tokenField.type = "text";
                toggleBtn.innerText = "🙈 Hide";
            } else {
                tokenField.type = "password";
                toggleBtn.innerText = "👁️ Show";
            }
        }

        async function handleTokenScraping() {
            clearInterval(countdownInterval);
            clearTimeout(clearClipboardTimeout);

            const statusLabel = document.getElementById('clipboardStatus');
            const tokenField = document.getElementById('secretTokenHolder');

            // ✅ ITINAMA: Kukunin ang value direkta mula sa input element (na nilagyan ng ViewBag ng server)
            const tokenValue = tokenField.value;

            if (!tokenValue || tokenValue.includes("Walang nahanap")) {
                alert("❌ Walang valid na token na nakuha mula sa server session. Subukang mag-logout at mag-login muli.");
                return;
            }

            try {
                // I-copy agad sa clipboard ang token mula sa value
                await navigator.clipboard.writeText(tokenValue);
                
                let secondsLeft = 5;
                statusLabel.style.display = "inline";
                statusLabel.className = "align-self-center text-success fw-bold";
                statusLabel.innerText = `📋 Copied! Manatili dito, clipboard clears in ${secondsLeft}s...`;

                countdownInterval = setInterval(() => {
                    secondsLeft--;
                    if (secondsLeft > 0) {
                        statusLabel.innerText = `📋 Copied! Manatili dito, clipboard clears in ${secondsLeft}s...`;
                    } else {
                        clearInterval(countdownInterval);
                    }
                }, 1000);

                // 🔥 AUTOMATED CLIPBOARD WIPEOUT
                clearClipboardTimeout = setTimeout(async () => {
                    try {
                        await navigator.clipboard.writeText(""); 
                        tokenField.value = "";
                        tokenField.type = "password";
                        
                        statusLabel.className = "align-self-center text-danger fw-bold";
                        statusLabel.innerText = "🧼 Safe! Clipboard and screen cleared successfully.";
                    } catch (err) {
                        statusLabel.className = "align-self-center text-warning fw-bold";
                        statusLabel.innerText = "⚠️ Error: Hindi nabura ang clipboard dahil umalis ka sa tab!";
                    }
                }, 5000);

            } catch (error) {
                console.error("Error during clipboard copy:", error);
                alert("May error sa pag-copy ng token.");
            }
        }
    </script>
}
