@model FlexiFit_AdminPanel.Models.User

@{
    ViewData["Title"] = "Edit User";
}

<div class="content-area">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 2rem;">
        <div>
            <h2 style="font-weight: 700;">Edit User</h2>
            <p style="color: #94a3b8;">Update profile information and permissions for <strong>@Model.username</strong>.</p>
        </div>
        <a asp-action="Index" class="btn btn-secondary">
            <i class="fas fa-arrow-left"></i> Back to List
        </a>
    </div>

    <div class="card">
        <div class="card-header">
            <h5><i class="fas fa-user-edit"></i> Update User Details</h5>
        </div>
        <div class="card-body">
            <form asp-action="Edit" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="user_id" />
                <input type="hidden" asp-for="firebase_uid" />
                <input type="hidden" asp-for="auth_provider" />
                <input type="hidden" asp-for="status" />
                <input type="hidden" asp-for="is_verified" />
                <input type="hidden" asp-for="created_at" />
                <input type="hidden" asp-for="updated_at" />

                <div class="form-grid">
                    <div>
                        <label asp-for="name">Full Name</label>
                        <input asp-for="name" placeholder="Enter full name" />
                        <span asp-validation-for="name" class="text-danger"></span>
                    </div>
                    <div>
                        <label asp-for="username">Username</label>
                        <input asp-for="username" placeholder="Enter username" required />
                        <span asp-validation-for="username" class="text-danger"></span>
                    </div>
                    <div class="full-width">
                        <label asp-for="email">Email Address</label>
                        <input asp-for="email" type="email" placeholder="email@example.com" required />
                        <span asp-validation-for="email" class="text-danger"></span>
                    </div>
                    <div class="full-width">
                        <label asp-for="role">System Role</label>
                        <select asp-for="role">
                            <option value="USER">User (Standard Access)</option>
                            <option value="ADMIN">Admin (Full Control)</option>
                        </select>
                        <span asp-validation-for="role" class="text-danger"></span>
                    </div>
                </div>

                <div style="display: flex; justify-content: flex-end; gap: 15px; margin-top: 30px; border-top: 1px solid #334155; padding-top: 25px;">
                    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
                    <button type="submit" class="btn"><i class="fas fa-save"></i> Save Changes</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}