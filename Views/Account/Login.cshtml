@model FlexiFit_AdminPanel.Models.LoginViewModel
@{
    Layout = null;
    ViewData["Title"] = "Admin Login";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />
    <link rel="stylesheet" href="~/css/login.css" />
</head>
<body>

<div class="login-card">
    <div class="login-header">
        <div class="text-center mb-3">
            <i class="fas fa-bolt text-primary fa-3x"></i>
        </div>
        <h2>Flexifit Admin</h2>
        <p>Enter your credentials to access the panel</p>
    </div>

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="error-msg text-center">
            <i class="fas fa-exclamation-circle me-1"></i>
            @Html.ValidationSummary(true, "")
        </div>
    }

    <!-- ============================================ -->
    <!-- LOGIN FORM (with Firebase Token hidden input) -->
    <!-- ============================================ -->
    <form id="loginform" asp-controller="Account" asp-action="Login" method="post">
        <!-- Hidden input for Firebase token -->
        <input type="hidden" id="firebaseTokenInput" name="FirebaseToken" />

        <div class="mb-3">
            <label asp-for="Username" class="form-label">Username</label>
            <input asp-for="Username" class="form-control" placeholder="admin" />
        </div>
        <div class="mb-3">
            <label asp-for="Password" class="form-label">Password</label>
            <input asp-for="Password" type="password" class="form-control" placeholder="••••••••" />
        </div>
        <button type="submit" class="btn-login btn-primary w-100">
            Sign In <i class="fas fa-arrow-right ms-2"></i>
        </button>
    </form>

    <!-- ============================================ -->
    <!-- DIVIDER -->
    <!-- ============================================ -->
    <div class="divider">
        <span>OR</span>
    </div>

    <!-- ============================================ -->
    <!-- GOOGLE SIGN-IN BUTTON -->
    <!-- ============================================ -->
    <button type="button" id="firebaseLoginBtn" class="btn-google w-100">
        <i class="fab fa-google me-2"></i> Sign in with Google
    </button>
</div>

<!-- ============================================ -->
<!-- FIREBASE SCRIPTS -->
<!-- ============================================ -->
<!-- Firebase SDK -->
<script src="https://www.gstatic.com/firebasejs/10.12.0/firebase-app-compat.js"></script>
<script src="https://www.gstatic.com/firebasejs/10.12.0/firebase-auth-compat.js"></script>

<!-- Firebase Config & Auth Logic -->
<script src="~/js/firebase-config.js"></script>
<script src="~/js/firebase-auth.js"></script>

</body>
</html>