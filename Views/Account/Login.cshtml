@model FlexiFit_AdminPanel.Models.LoginViewModel
@{
    Layout = null; // Para hindi sumama ang sidebar dito
    ViewData["Title"] = "Admin Login";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />

    <!-- Login CSS -->
    <link rel="stylesheet" href="~/css/login.css" />

    <!-- Firebase SDK -->
    <script src="https://www.gstatic.com/firebasejs/9.22.0/firebase-app-compat.js"></script>
    <script src="https://www.gstatic.com/firebasejs/9.22.0/firebase-auth-compat.js"></script>

    <!-- Firebase Config -->
    <script src="~/js/firebase-config.js"></script>

    <!-- Firebase Auth JS (for interop) -->
    <script src="~/js/firebase-auth.js"></script>
</head>
<body>

    <div class="login-card">
        <div class="login-header">
            <div class="text-center mb-3">
                <i class="fas fa-bolt text-primary fa-3x"></i>
            </div>

            <!-- 🔥 Blazor Component -->
            <component type="typeof(FlexiFit_AdminPanel.Components.Login)" render-mode="Server" />
        </div>    
    </div>

<!-- 🔥 Blazor Server Script -->
<script src="/_framework/blazor.server.js"></script>

</body>
</html>